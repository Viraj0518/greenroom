{
  "name": "greenroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "wrangler pages dev",
    "dev:app": "vite",
    "build": "vite build",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name greenroom-dev",
    "test": "vitest run -c tests/vitest.config.ts --passWithNoTests",
    "test:watch": "vitest -c tests/vitest.config.ts",
    "smoke": "node tests/smoke.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply greenroom-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply greenroom-db --remote"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "dompurify": "^3.4.13",
    "hono": "^4.8.0",
    "marked": "^18.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
